# SEO-04: server-only (do not prefix service-role key with PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_VIA_PRIVATE_VERCEL_ENV_ONLY
RFQ_RATE_SALT=GENERATE_RANDOM_SECRET_AT_LEAST_32_BYTES
RFQ_ADMIN_USER_IDS=UUID_OF_APPROVED_SUPABASE_AUTH_USER
# Optional delivery; leave disabled until verified
RESEND_API_KEY=
RFQ_NOTIFICATION_TO=
RFQ_NOTIFICATION_FROM=
# Public (safe to publish anon key, unlike service-role key)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY_FROM_SUPABASE
SEO_APPROVED_FOR_INDEXING=false
