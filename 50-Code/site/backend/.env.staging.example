APP_DB_PASSWORD=REPLACE_RUNTIME_DB_PASSWORD
DATABASE_URL_MIGRATE=postgresql://rfq_owner:REPLACE_OWNER_DB_PASSWORD@postgres:5432/twd_rfq
DATABASE_URL_RUNTIME=postgresql://rfq_app:REPLACE_RUNTIME_DB_PASSWORD@postgres:5432/twd_rfq
BACKEND_SHARED_TOKEN=REPLACE_64_CHARACTER_RANDOM_SECRET
RFQ_RATE_SALT=REPLACE_64_CHARACTER_RANDOM_SECRET
UPLOAD_QUOTA_BYTES=100000000
NOTIFICATION_WORKER=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
