    "@fastify/multipart": "^9.2.1",
    "argon2": "^0.44.0",
    "pg": "^8.16.0",
    "nodemailer": "^7.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/nodemailer": "^7.0.0",
    "typescript": "^5.9.0"
