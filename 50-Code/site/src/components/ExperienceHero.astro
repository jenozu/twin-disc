---
import { publicProducts } from "../data/products";
---
<section class="xp-hero" aria-labelledby="xp-title">
  <div class="xp-hero__grid" aria-hidden="true"></div>
  <div class="xp-hero__glow" aria-hidden="true"></div>
  <div class="shell xp-hero__inner">
    <div class="xp-hero__copy" data-reveal>
      <p class="xp-kicker"><span class="xp-kicker__bar"></span> INDEPENDENT INDUSTRIAL PARTS SOURCING <span>/ 001</span></p>
      <h1 id="xp-title">Power<br /><em>in motion.</em></h1>
      <p class="xp-hero__lead">Precision components. Real applications. A clearer way to find the part that keeps your equipment moving.</p>
      <div class="xp-hero__actions">
        <a class="xp-button xp-button--cream" href="/products">Explore the catalogue <span aria-hidden="true">↗</span></a>
        <a class="xp-text-link" href="/rfq">Identify a part <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="xp-machine" role="img" aria-label="Concept illustration of a mechanical industrial powertrain assembly, not a product or fitment drawing.">
      <div class="xp-machine__halo" aria-hidden="true"></div>
      <svg viewBox="0 0 760 700" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="xp-steel" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e4dfd3"/><stop offset=".2" stop-color="#707f86"/><stop offset=".44" stop-color="#c7cdc9"/><stop offset=".7" stop-color="#596770"/><stop offset="1" stop-color="#d9d1be"/></linearGradient>
          <linearGradient id="xp-edge" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#9aa4a5"/><stop offset=".46" stop-color="#17232c"/><stop offset="1" stop-color="#606d72"/></linearGradient>
          <radialGradient id="xp-inner"><stop stop-color="#152029"/><stop offset=".6" stop-color="#0b131b"/><stop offset="1" stop-color="#53646b"/></radialGradient>
        </defs>
        <ellipse cx="376" cy="591" rx="230" ry="39" fill="#03080c" opacity=".42"/>
        <g class="xp-machine__rear" transform="translate(480 291) rotate(-20) scale(1 .82)" opacity=".75">
          <circle r="184" fill="#253139" stroke="#a7adaa" stroke-width="14"/>
          <circle r="160" fill="#111b22" stroke="#5d6a72" stroke-width="14"/>
          <circle r="133" fill="none" stroke="#c0ae8e" stroke-dasharray="8 11" stroke-width="4"/>
          <circle r="87" fill="#18252c" stroke="#d3c6ad" stroke-width="13"/>
        </g>
        <path d="M237 196 387 133 Q538 130 619 234 L516 389 302 461Z" fill="url(#xp-edge)" stroke="#9da8a9" stroke-width="3"/>
        <path d="M234 504 363 538 Q550 539 620 383 L517 389 302 461Z" fill="#2d3942" stroke="#879398" stroke-width="3"/>
        <g class="xp-machine__front" transform="translate(350 362) rotate(-20) scale(1 .84)">
          <circle r="224" fill="#111b22" stroke="#6d7c83" stroke-width="8"/>
          <circle r="213" fill="url(#xp-steel)" stroke="#b9b6ab" stroke-width="7"/>
          <circle r="194" fill="#26333b" stroke="#0d171e" stroke-width="11"/>
          <circle r="177" fill="url(#xp-steel)" stroke="#cad0cb" stroke-width="3"/>
          <circle r="159" fill="#18252d" stroke="#54656c" stroke-width="8" stroke-dasharray="7 5"/>
          <circle r="135" fill="url(#xp-edge)" stroke="#b7b6a8" stroke-width="7"/>
          <circle r="109" fill="#172129" stroke="#6d7b80" stroke-width="7"/>
          <g fill="#101a20" stroke="#d9d0b9" stroke-width="5">
            <circle cx="0" cy="-202" r="11"/><circle cx="143" cy="-143" r="11"/><circle cx="202" cy="0" r="11"/><circle cx="143" cy="143" r="11"/><circle cx="0" cy="202" r="11"/><circle cx="-143" cy="143" r="11"/><circle cx="-202" cy="0" r="11"/><circle cx="-143" cy="-143" r="11"/>
          </g>
          <g stroke="#aeb8b9" stroke-width="5"><path d="M0-105V-70M0 105V70M-105 0h35M105 0H70M-75-75l25 25M75 75 50 50M-75 75l25-25M75-75 50-50"/></g>
          <circle r="79" fill="url(#xp-steel)" stroke="#222e36" stroke-width="8"/>
          <circle r="61" fill="url(#xp-inner)" stroke="#c5c5b8" stroke-width="5"/>
          <circle r="35" fill="#081017" stroke="#67747d" stroke-width="9"/>
          <circle r="10" fill="#0e171f" stroke="#b3af9e" stroke-width="3"/>
        </g>
        <path d="M103 180 215 241M573 515 484 458" fill="none" stroke="#cba471" stroke-width="1.7"/>
        <circle cx="215" cy="241" r="4" fill="#cba471"/><circle cx="484" cy="458" r="4" fill="#cba471"/>
      </svg>
      <span class="xp-machine__tag xp-machine__tag--one">01 / POWER TRANSFER</span>
      <span class="xp-machine__tag xp-machine__tag--two">MECHANICAL SYSTEM <small>CONCEPT / NOT TO SCALE</small></span>
      <span class="xp-crosshair xp-crosshair--one" aria-hidden="true">+</span><span class="xp-crosshair xp-crosshair--two" aria-hidden="true">+</span>
    </div>
    <div class="xp-hero__footer"><span>ENGINEERING THE CONNECTION</span><span>SCROLL TO DISCOVER &nbsp; ↓</span><span>{publicProducts.length} PART REFERENCES / RFQ</span></div>
  </div>
</section>