---
import type { PublicationStatus } from "../lib/seo";
interface Props { status: PublicationStatus }
const { status } = Astro.props;
---
<span class="seo-status" title="Editorial publishing status">{status}</span>
<style>.seo-status{display:inline-block;padding:.3rem .6rem;border:1px solid #9ba9aa;border-radius:3px;font-size:.8rem;font-weight:600;letter-spacing:.02em}</style>
