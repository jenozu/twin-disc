---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabels, publicProducts, twinDiscProducts } from "../../data/products";

const families = [...new Set(publicProducts.map((product) => product.family))];
---
<BaseLayout title="Product Catalogue | Powertrain Parts">
  <section class="page-masthead catalogue-masthead">
    <div class="shell masthead-grid">
      <div>
        <p class="section-label">Product catalogue</p>
        <h1>Search the part you already have.</h1>
      </div>
      <div class="masthead-copy">
        <p>
          Search by part number, product type or <span translate="no">Twin Disc</span> model family. Every RFQ is verified before ordering.
        </p>
        <a class="text-link" href="/rfq">Need help identifying a unit? <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="catalogue shell">
    <div class="catalogue-toolbar" aria-label="Catalogue filters">
      <div class="catalogue-search">
        <label for="product-search">Search catalogue</label>
        <div class="catalogue-search__control">
          <span aria-hidden="true">⌕</span>
          <input
            id="product-search"
            type="search"
            placeholder="SP318C003, clutch, CX110…"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="search-status"
          />
        </div>
      </div>

      <div class="catalogue-meta" aria-live="polite">
        <strong id="result-count">{publicProducts.length}</strong>
        <span>launch products</span>
      </div>
    </div>

    <div class="family-filter" aria-label="Filter by product family">
      <button class="filter-chip is-active" type="button" data-family="" aria-pressed="true">All</button>
      {families.map((family) => (
        <button class="filter-chip" type="button" data-family={family.toLowerCase()} aria-pressed="false">
          {family}
        </button>
      ))}
    </div>

    <p id="search-status" class="sr-only" aria-live="polite"></p>

    <div class="catalogue-surface">
      <div class="catalogue-table__head" aria-hidden="true">
        <span>Part number</span>
        <span>Product</span>
        <span>Model family</span>
        <span></span>
      </div>

      <div id="product-grid">
        {publicProducts.map((product) => (
          <article
            class="catalogue-row"
            data-family={product.family.toLowerCase()}
            data-search={`${product.partNumber} ${product.title} ${product.family} ${product.modelFamily}`.toLowerCase()}
          >
            <a class="part-number" href={`/products/${product.sku.toLowerCase()}`} translate="no">
              {product.partNumber}
            </a>
            <div class="catalogue-product">
              <span class="family-badge">{product.family}</span>
              <strong>{product.title}</strong>
            </div>
            <span class="model-family">{product.modelFamily}</span>
            <a class="row-action" href={`/products/${product.sku.toLowerCase()}`}>
              View part <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div id="no-results" class="empty-state" hidden>
      <span class="empty-state__mark" aria-hidden="true">⌕</span>
      <strong>No matching launch products.</strong>
      <p>Try the exact part number, a shorter model family such as CX110, or reset the product-family filter.</p>
      <a class="text-link" href="/rfq">Send an RFQ instead <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="model-guide-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="section-label">Model guides</p>
          <h2>Technical reference by family.</h2>
        </div>
        <p class="section-copy">
          Specifications, application context, rebuild information and RFQ requirements for priority Twin Disc model families.
        </p>
      </div>

      <div class="guide-grid">
        {twinDiscProducts.map((product) => (
          <a class="guide-card" href={`/products/${product.id}/`}>
            <div class="guide-card__top">
              <span>{categoryLabels[product.category]}</span>
              <b aria-hidden="true">↗</b>
            </div>
            <strong translate="no">{product.modelName}</strong>
            <p>{product.heroSubtitle}</p>
            <span class="guide-card__footer">Technical reference & RFQ</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>("#product-search");
    const rows = [...document.querySelectorAll<HTMLElement>(".catalogue-row")];
    const chips = [...document.querySelectorAll<HTMLButtonElement>(".filter-chip")];
    const empty = document.querySelector<HTMLElement>("#no-results");
    const count = document.querySelector<HTMLElement>("#result-count");
    const status = document.querySelector<HTMLElement>("#search-status");

    let selectedFamily = "";

    const applyFilters = (query: string, family: string, updateUrl = true) => {
      const normalized = query.trim().toLowerCase();
      const normalizedFamily = family.trim().toLowerCase();
      let visible = 0;

      rows.forEach((row) => {
        const matchesQuery = !normalized || (row.dataset.search ?? "").includes(normalized);
        const matchesFamily = !normalizedFamily || row.dataset.family === normalizedFamily;
        const show = matchesQuery && matchesFamily;
        row.hidden = !show;
        if (show) visible += 1;
      });

      selectedFamily = normalizedFamily;
      chips.forEach((chip) => {
        const active = (chip.dataset.family ?? "") === selectedFamily;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", String(active));
      });

      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = `${visible} catalogue result${visible === 1 ? "" : "s"} shown.`;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (query.trim()) url.searchParams.set("q", query.trim());
        else url.searchParams.delete("q");
        if (selectedFamily) url.searchParams.set("family", selectedFamily);
        else url.searchParams.delete("family");
        history.replaceState({}, "", url);
      }
    };

    const url = new URL(window.location.href);
    const initialQuery = url.searchParams.get("q") ?? "";
    const initialFamily = url.searchParams.get("family") ?? "";

    if (input) {
      input.value = initialQuery;
      input.addEventListener("input", () => applyFilters(input.value, selectedFamily));
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        applyFilters(input?.value ?? "", chip.dataset.family ?? "");
      });
    });

    applyFilters(initialQuery, initialFamily, false);
  </script>
</BaseLayout>
