---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabels, publicProducts, twinDiscProducts } from "../../data/products";

const families = [...new Set(publicProducts.map((product) => product.family))];
---
<BaseLayout title="Product Catalogue | Powertrain Parts">
  <section class="catalogue-hero">
    <div class="shell">
      <div class="catalogue-hero__top" data-reveal>
        <p class="registry-code">INDEX / 01</p>
        <span>{publicProducts.length} PART REFERENCES / {families.length} FAMILIES</span>
      </div>

      <div class="catalogue-hero__grid" data-reveal>
        <h1>Catalogue</h1>
        <p>
          Search the exact identifier first. A catalogue result is a reference—not a final fitment decision.
        </p>
      </div>

      <div class="catalogue-search-shell" data-reveal>
        <label for="product-search">Search part number, family or model</label>
        <div class="catalogue-search-control">
          <input
            id="product-search"
            type="search"
            placeholder="SP318C003  /  CX110  /  clutch"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="search-status"
          />
          <span><strong id="result-count">{publicProducts.length}</strong> MATCHES</span>
        </div>
      </div>
    </div>
  </section>

  <section class="catalogue shell">
    <p id="search-status" class="sr-only" aria-live="polite"></p>

    <div class="catalogue-table" id="product-grid">
      <div class="catalogue-table__head" aria-hidden="true">
        <span>Part number</span>
        <span>Product family</span>
        <span>Model family</span>
        <span>Action</span>
      </div>

      {publicProducts.map((product) => (
        <article
          class="catalogue-row"
          data-search={(product.partNumber + " " + product.title + " " + product.family + " " + product.modelFamily).toLowerCase()}
        >
          <a class="part-number" href={"/products/" + product.sku.toLowerCase()} translate="no">
            {product.partNumber}
          </a>
          <span>{product.family}</span>
          <span class="model-family">{product.modelFamily}</span>
          <a class="row-action" href={"/products/" + product.sku.toLowerCase()}>Open record <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>

    <div id="no-results" class="empty-state" hidden>
      <strong>No matching launch references.</strong>
      <p>Try the full part number, a shorter family such as CX110, or a component type such as clutch.</p>
      <a class="text-link" href="/rfq">Send the identifiers you have <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="model-register">
    <div class="shell" data-reveal>
      <div class="model-register__heading">
        <div>
          <p class="kicker kicker-on-dark">Technical register</p>
          <h2>Model-family guides</h2>
        </div>
        <p>Specifications, applications, rebuild information and RFQ guidance for priority <span translate="no">Twin Disc</span> model families.</p>
      </div>

      <div class="model-register__list">
        {twinDiscProducts.map((product, index) => (
          <a href={"/products/" + product.id + "/"}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong translate="no">{product.modelName}</strong>
            <em>{categoryLabels[product.category]}</em>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>("#product-search");
    const rows = [...document.querySelectorAll<HTMLElement>(".catalogue-row")];
    const empty = document.querySelector<HTMLElement>("#no-results");
    const count = document.querySelector<HTMLElement>("#result-count");
    const status = document.querySelector<HTMLElement>("#search-status");

    const applySearch = (query: string, updateUrl = true) => {
      const normalized = query.trim().toLowerCase();
      let visible = 0;

      rows.forEach((row) => {
        const show = !normalized || (row.dataset.search ?? "").includes(normalized);
        row.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = visible + " catalogue result" + (visible === 1 ? "" : "s") + " shown.";

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (query.trim()) url.searchParams.set("q", query.trim());
        else url.searchParams.delete("q");
        history.replaceState({}, "", url);
      }
    };

    const initialQuery = new URL(window.location.href).searchParams.get("q") ?? "";
    if (input) {
      input.value = initialQuery;
      applySearch(initialQuery, false);
      input.addEventListener("input", () => applySearch(input.value));
    }
  </script>
</BaseLayout>
