---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicProducts } from "../../data/products";
const families = [...new Set(publicProducts.map((product) => product.family))];
---
<BaseLayout title="Product Catalogue | Powertrain Parts" description="Search 18 launch part references for Twin Disc PTO, clutch and pump-drive components. Verify exact equipment compatibility before ordering.">
  <section class="catalogue-experience shell" aria-labelledby="catalogue-heading">
    <div class="catalogue-heading">
      <div>
        <p class="kicker">01 / PRODUCT CATALOGUE</p>
        <h1 id="catalogue-heading">Find the right <em>part.</em></h1>
        <p>Browse reference parts by family or search the number on your equipment. Every application requires verification before ordering.</p>
      </div>
      <a href="/rfq" class="catalogue-heading__help">Have a serial or nameplate? <strong>Get identification help ↗</strong></a>
    </div>
    <div class="catalogue-control-panel">
      <div class="catalogue-control-panel__top">
        <label for="product-search">SEARCH CATALOGUE</label>
        <div class="catalogue-control-panel__count"><strong id="result-count">{publicProducts.length}</strong> <span>matching launch parts</span></div>
      </div>
      <div class="catalogue-control-panel__search">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
        <input id="product-search" type="search" placeholder="Search SP318C003, clutch, CX110…" autocomplete="off" spellcheck="false" aria-describedby="search-status" />
      </div>
      <div class="catalogue-filter-bar" role="group" aria-label="Filter by product family">
        <button type="button" class="catalogue-filter is-active" data-family="all" aria-pressed="true">All parts</button>
        {families.map((family) => <button type="button" class="catalogue-filter" data-family={family.toLowerCase()} aria-pressed="false">{family}</button>)}
      </div>
    </div>
    <p id="search-status" class="sr-only" aria-live="polite"></p>
    <div class="catalogue-card-grid" id="product-grid">
      {publicProducts.map((product, index) => (
        <article class="catalogue-product-card" data-family={product.family.toLowerCase()} data-search={`${product.partNumber} ${product.title} ${product.family} ${product.modelFamily}`.toLowerCase()}>
          <div class="catalogue-product-card__top"><span class="catalogue-product-card__badge">{product.family}</span><span class="catalogue-product-card__index">{String(index + 1).padStart(2, "0")}</span></div>
          <div class="catalogue-product-card__body">
            <p class="catalogue-product-card__eyebrow">TWIN DISC / PART REFERENCE</p>
            <h2 translate="no"><a href={`/products/${product.sku.toLowerCase()}`}>{product.partNumber}</a></h2>
            <p class="catalogue-product-card__description">{product.title}</p>
          </div>
          <dl class="catalogue-product-card__specs">
            <div><dt>Model family</dt><dd>{product.modelFamily}</dd></div>
            <div><dt>Page type</dt><dd>{product.pageType}</dd></div>
          </dl>
          <a class="catalogue-product-card__link" href={`/products/${product.sku.toLowerCase()}`}>View part details <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    <div id="no-results" class="catalogue-no-results" hidden>
      <strong>No matching launch parts</strong>
      <p>Try a shorter reference number, another category, or send the equipment details for identification help.</p>
      <button type="button" id="reset-filters">Clear search and filters</button>
      <a href="/rfq">Start an RFQ ↗</a>
    </div>
    <aside class="catalogue-support-strip">
      <span>NOT SURE OF THE EXACT PART?</span>
      <p>A model, serial, BOM or equipment nameplate can help narrow the search.</p>
      <a href="/rfq">Request part identification ↗</a>
    </aside>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>("#product-search");
    const rows = [...document.querySelectorAll<HTMLElement>(".catalogue-product-card")];
    const filters = [...document.querySelectorAll<HTMLButtonElement>(".catalogue-filter")];
    const empty = document.querySelector<HTMLElement>("#no-results");
    const count = document.querySelector<HTMLElement>("#result-count");
    const status = document.querySelector<HTMLElement>("#search-status");
    const reset = document.querySelector<HTMLButtonElement>("#reset-filters");
    let activeFamily = "all";
    const update = (writeUrl = true) => {
      const query = (input?.value ?? "").trim().toLowerCase();
      let visible = 0;
      rows.forEach((card) => {
        const show = (!query || (card.dataset.search ?? "").includes(query)) && (activeFamily === "all" || card.dataset.family === activeFamily);
        card.hidden = !show;
        if (show) visible++;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = `${visible} matching launch part${visible === 1 ? "" : "s"}.`;
      filters.forEach((filter) => {
        const selected = filter.dataset.family === activeFamily;
        filter.classList.toggle("is-active", selected);
        filter.setAttribute("aria-pressed", String(selected));
      });
      if (writeUrl) {
        const url = new URL(location.href);
        if (query) url.searchParams.set("q", input?.value.trim() ?? "");
        else url.searchParams.delete("q");
        if (activeFamily !== "all") url.searchParams.set("family", activeFamily);
        else url.searchParams.delete("family");
        history.replaceState(null, "", url);
      }
    };
    filters.forEach((filter) => filter.addEventListener("click", () => { activeFamily = filter.dataset.family ?? "all"; update(); }));
    input?.addEventListener("input", () => update());
    reset?.addEventListener("click", () => { if (input) input.value = ""; activeFamily = "all"; update(); input?.focus(); });
    const params = new URLSearchParams(location.search);
    if (input) input.value = params.get("q") ?? "";
    const requestedFamily = (params.get("family") ?? "").toLowerCase();
    if (filters.some((filter) => filter.dataset.family === requestedFamily)) activeFamily = requestedFamily;
    update(false);
  </script>
</BaseLayout>
