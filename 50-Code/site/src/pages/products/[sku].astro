---
import "../../styles/tokens.css";
import "../../styles/emil-catalogue.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  SPEC_DISCLAIMER,
  categoryLabels,
  getRelatedProducts,
  productNotes,
  publicProducts,
  twinDiscProducts,
} from "../../data/products";
import type { Product, ProductModel } from "../../data/products";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TechnicalSpecTable from "../../components/TechnicalSpecTable.astro";
import { webpageSchema } from "../../lib/seo";

type RouteProps =
  | { kind: "sku"; product: Product }
  | { kind: "model"; product: ProductModel };

export function getStaticPaths() {
  return [
    ...publicProducts.map((product) => ({
      params: { sku: product.sku.toLowerCase() },
      props: { kind: "sku" as const, product },
    })),
    ...twinDiscProducts.map((product) => ({
      params: { sku: product.id },
      props: { kind: "model" as const, product },
    })),
  ];
}

const route = Astro.props as RouteProps;
const skuProduct = route.kind === "sku" ? route.product : undefined;
const modelProduct = route.kind === "model" ? route.product : undefined;

const title = modelProduct
  ? modelProduct.metaTitle
  : skuProduct
    ? skuProduct.partNumber + " | Powertrain Parts"
    : "Powertrain Parts";

const description = modelProduct
  ? modelProduct.metaDescription
  : skuProduct
    ? "RFQ and identification page for Twin Disc " +
      skuProduct.partNumber +
      ". Compatibility must be verified before ordering."
    : "Independent sourcing and RFQ support for Twin Disc powertrain products.";

const canonicalUrl = Astro.url.pathname;
const structuredData = [webpageSchema(title, description, Astro.url.pathname)];

const relatedProducts = modelProduct ? getRelatedProducts(modelProduct) : [];
const skuNotes = skuProduct && !["SP314C002", "6926E"].includes(skuProduct.partNumber) ? productNotes[skuProduct.partNumber] ?? [] : [];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  robots="noindex, follow"
>
  {modelProduct ? (
    <>
      <section class="product-masthead">
        <div class="shell">
          <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Catalogue", href: "/products" }, { label: modelProduct.modelName, href: Astro.url.pathname }]} />

          <div class="product-title-grid">
            <div class="product-title-copy">
              <p class="section-label section-label--dark">{categoryLabels[modelProduct.category]}</p>
              <h1 class="model-hero" translate="no">{modelProduct.h1}</h1>
              <p class="product-subtitle">{modelProduct.heroSubtitle}</p>
            </div>

            <aside class="product-identity-card" aria-label="Quote and fitment status">
              <div>
                <span>Pricing</span>
                <strong>Request for quote</strong>
              </div>
              <div>
                <span>Fitment</span>
                <strong>Serial / BOM verification</strong>
              </div>
              <div>
                <span>Support</span>
                <strong>Email-first technical review</strong>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="section shell product-sheet">
        <div class="product-main">
          <section class="content-section">
            <div class="section-rule">
              <span>01</span>
              <h2>Product overview</h2>
            </div>

            <div class="model-intro">
              <p>{modelProduct.introParagraph}</p>
            </div>

            {modelProduct.aliases && modelProduct.aliases.length > 0 && (
              <p class="model-aliases">
                <strong>Also referenced as</strong>
                <span>{modelProduct.aliases.join(", ")}</span>
              </p>
            )}
          </section>

          <section class="content-section">
            <div class="section-rule">
              <span>02</span>
              <h2>Technical specifications</h2>
            </div>

            <TechnicalSpecTable specs={modelProduct.specs} caption="Model family specifications (configuration-dependent)" />

            <p class="spec-disclaimer">{SPEC_DISCLAIMER}</p>
          </section>

          <section class="content-section">
            <div class="section-rule">
              <span>03</span>
              <h2>Common applications</h2>
            </div>

            <div class="application-grid">
              {modelProduct.commonApplications.map((application) => (
                <span>{application}</span>
              ))}
            </div>
          </section>

          <section class="content-section">
            <div class="section-rule">
              <span>04</span>
              <h2>Technical FAQs</h2>
            </div>

            <div class="faq-list">
              {modelProduct.faqs.map((faq) => (
                <details class="faq-item">
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>

          {relatedProducts.length > 0 && (
            <section class="content-section">
              <div class="section-rule">
                <span>05</span>
                <h2>Related Twin Disc products</h2>
              </div>

              <div class="related-product-list">
                {relatedProducts.map((related) => (
                  <a href={"/products/" + related.id + "/"}>
                    <span>{categoryLabels[related.category]}</span>
                    <strong>{related.modelName}</strong>
                    <b aria-hidden="true">→</b>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="quote-panel">
          <div class="quote-panel__header">
            <span>RFQ / model identification</span>
            <span class="live-indicator"><i aria-hidden="true"></i> Open</span>
          </div>
          <div class="quote-panel__body">
            <p class="quote-panel__eyebrow">Verification checklist</p>
            <h2>Verify your unit.</h2>
            <p>
              Send the strongest identifiers you have. They reduce fitment risk before a quote becomes an order.
            </p>

            <ul class="check-list">
              {(modelProduct.quoteRequiredFields ?? [
                "Full model number",
                "Serial number",
                "BOM / assembly number",
                "Application details",
              ]).map((field) => (
                <li>{field}</li>
              ))}
            </ul>

            <a
              class="button button-block"
              href={"/rfq?part=" + encodeURIComponent(modelProduct.modelName)}
            >
              Request quote <span aria-hidden="true">→</span>
            </a>
            <a class="text-link text-link-center" href="/products">Return to catalogue</a>
          </div>
        </aside>
      </section>
    </>
  ) : skuProduct ? (
    <>
      <section class="product-masthead">
        <div class="shell">
          <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Catalogue", href: "/products" }, { label: skuProduct.partNumber, href: Astro.url.pathname }]} />

          <div class="product-title-grid">
            <div class="product-title-copy">
              <p class="section-label section-label--dark">{skuProduct.family}</p>
              <h1 class="part-hero" translate="no">{skuProduct.partNumber}</h1>
              <p class="product-subtitle">{skuProduct.title}</p>
            </div>

            <aside class="product-identity-card" aria-label="Quote and fitment status">
              <div>
                <span>Pricing</span>
                <strong>Request for quote</strong>
              </div>
              <div>
                <span>Fitment</span>
                <strong>Verification required</strong>
              </div>
              <div>
                <span>Model family</span>
                <strong>{skuProduct.modelFamily}</strong>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="section shell product-sheet">
        <div class="product-main">
          <section class="content-section">
            <div class="section-rule">
              <span>01</span>
              <h2>Product identification</h2>
            </div>

            <div class="spec-table">
              <div>
                <span>Manufacturer</span>
                <strong translate="no">Twin Disc</strong>
              </div>
              <div>
                <span>Part number</span>
                <strong class="mono" translate="no">{skuProduct.partNumber}</strong>
              </div>
              <div>
                <span>Product family</span>
                <strong>{skuProduct.family}</strong>
              </div>
              <div>
                <span>Model family</span>
                <strong>{skuProduct.modelFamily}</strong>
              </div>
              <div>
                <span>Page type</span>
                <strong>{skuProduct.pageType}</strong>
              </div>
              <div>
                <span>Price</span>
                <strong>RFQ</strong>
              </div>
            </div>
          </section>

          <details class="product-notes">
            <summary>
              <span>
                <small>Research notes</small>
                Product and cross-reference context
              </span>
              <span class="product-notes__toggle" aria-hidden="true">+</span>
            </summary>

            <div class="product-notes__body">
              <div class="product-note-group">
                <h3>Product / model information</h3>
                <ul>
                  <li><strong>Model family:</strong> {skuProduct.modelFamily}</li>
                  <li><strong>Part type:</strong> {skuProduct.pageType}</li>
                </ul>
              </div>

              {skuNotes.map((note) => (
                <div class="product-note-group">
                  <h3>{note.heading}</h3>
                  <ul>
                    {note.items.map((item) => (
                      <li translate="no">{item}</li>
                    ))}
                  </ul>
                </div>
              ))}

              <div class="product-note-group product-note-group--warning">
                <h3>Fitment verification</h3>
                <p>
                  Cross-reference, replacement and application information is provided as a research aid. Confirm the exact PTO or clutch tag, serial number, BOM / assembly number and equipment configuration before ordering.
                </p>
              </div>
            </div>
          </details>

          <section class="content-section">
            <div class="section-rule">
              <span>02</span>
              <h2>Compatibility standard</h2>
            </div>

            <div class="verification-copy">
              <p>
                Do not order from a part number alone when the application is uncertain. Exact compatibility and current availability should be verified before the quote becomes an order.
              </p>
              <p>
                The strongest identifiers are the PTO or clutch tag, serial number, OEM number, equipment model and engine model.
              </p>
            </div>
          </section>
        </div>

        <aside class="quote-panel">
          <div class="quote-panel__header">
            <span>RFQ / part identification</span>
            <span class="live-indicator"><i aria-hidden="true"></i> Open</span>
          </div>
          <div class="quote-panel__body">
            <p class="quote-panel__eyebrow">Verification checklist</p>
            <h2>Verify this part.</h2>
            <p>Send the equipment information you have. Not every field is required.</p>

            <ul class="check-list">
              <li>Equipment make & model</li>
              <li>Engine make & model</li>
              <li>PTO / clutch tag or serial</li>
              <li>OEM part number</li>
            </ul>

            <a
              class="button button-block"
              href={"/rfq?part=" + encodeURIComponent(skuProduct.partNumber)}
            >
              Request quote <span aria-hidden="true">→</span>
            </a>
            <a class="text-link text-link-center" href="/products">Return to catalogue</a>
          </div>
        </aside>
      </section>
    </>
  ) : null}
</BaseLayout>
