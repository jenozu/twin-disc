---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicProducts } from "../data/products";

const families = [...new Set(publicProducts.map((product) => product.family))];
const featured = publicProducts.slice(0, 8);
const familyCounts = families.map((family) => ({
  family,
  count: publicProducts.filter((product) => product.family === family).length,
}));
---
<BaseLayout title="Industrial PTO, Clutch & Pump-Drive Parts">
  <section class="registry-hero">
    <div class="shell registry-hero__inner">
      <div class="registry-line" data-reveal>
        <span>INDEPENDENT INDUSTRIAL SOURCING</span>
        <span>CATALOGUE / {publicProducts.length} LIVE REFERENCES</span>
      </div>

      <div class="registry-grid">
        <div class="registry-copy" data-reveal>
          <p class="registry-code">PT / PARTS DESK / 01</p>
          <h1>The part number is only half the answer.</h1>
          <p class="registry-lead">
            Search <span translate="no">Twin Disc</span> references, then verify the machine, engine, tag or serial before an order becomes a fitment claim.
          </p>
        </div>

        <aside class="registry-index" data-reveal data-reveal-delay="0.08" aria-label="Catalogue registry">
          <div class="registry-index__title">
            <span>LIVE INDEX</span>
            <span class="status-mark">ACTIVE</span>
          </div>
          <dl>
            <div><dt>REFERENCES</dt><dd>{String(publicProducts.length).padStart(2, "0")}</dd></div>
            <div><dt>FAMILIES</dt><dd>{String(families.length).padStart(2, "0")}</dd></div>
            <div><dt>PRICING</dt><dd>RFQ</dd></div>
            <div><dt>FITMENT</dt><dd>VERIFY</dd></div>
          </dl>
          <p>No guessed compatibility. No generic checkout flow. Start with the evidence already on the machine.</p>
        </aside>
      </div>

      <form class="registry-search" action="/products" method="get" data-reveal>
        <div class="registry-search__label">
          <span>SEARCH / 01</span>
          <label for="hero-part-search">Part number, product family or model</label>
        </div>
        <div class="registry-search__control">
          <input
            id="hero-part-search"
            name="q"
            type="search"
            placeholder="SP318C003  /  CX110  /  clutch"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="submit">
            Search index
            <span aria-hidden="true">↗</span>
          </button>
        </div>
      </form>

      <div class="family-ledger" data-reveal>
        {familyCounts.map(({ family, count }, index) => (
          <div>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{family}</strong>
            <b>{String(count).padStart(2, "0")}</b>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-intro shell" data-reveal>
    <p class="kicker">A different kind of parts catalogue</p>
    <div class="editorial-intro__grid">
      <h2>Built for the moment when “looks right” is not good enough.</h2>
      <div class="editorial-copy">
        <p>
          Industrial components often share families, housings and naming patterns. The catalogue gets you to the reference quickly; the RFQ captures the evidence needed to verify the application.
        </p>
        <a class="text-link" href="/rfq">Identify an uncertain part <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="index-section shell" data-reveal>
    <div class="index-heading">
      <span>SELECTED INDEX / 08</span>
      <h2>Launch references</h2>
      <a href="/products">Full catalogue ↗</a>
    </div>

    <div class="part-index">
      <div class="part-index__head" aria-hidden="true">
        <span>ID</span>
        <span>Part number</span>
        <span>Family</span>
        <span>Model family</span>
        <span></span>
      </div>
      {featured.map((product, index) => (
        <a class="part-index__row" href={"/products/" + product.sku.toLowerCase()}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong translate="no">{product.partNumber}</strong>
          <span>{product.family}</span>
          <span>{product.modelFamily}</span>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="evidence-band">
    <div class="shell evidence-band__grid">
      <div class="evidence-band__lead" data-reveal>
        <p class="kicker kicker-on-accent">When the catalogue stops</p>
        <h2>Use the machine as the source document.</h2>
      </div>

      <div class="evidence-steps" data-reveal data-reveal-delay="0.08">
        <article>
          <span>01 / READ</span>
          <h3>Find the tag</h3>
          <p>Capture the PTO, clutch or transmission tag, model and serial information.</p>
        </article>
        <article>
          <span>02 / CONTEXT</span>
          <h3>Add the machine</h3>
          <p>Equipment make/model and engine details help narrow the application.</p>
        </article>
        <article>
          <span>03 / RFQ</span>
          <h3>Verify before order</h3>
          <p>Carry the known identifiers into one quote request instead of restarting the search.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
