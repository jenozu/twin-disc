---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabels, publicProducts, twinDiscProducts } from "../data/products";

const families = [...new Set(publicProducts.map((product) => product.family))];
const featured = publicProducts.slice(0, 6);
const modelGuides = twinDiscProducts.slice(0, 3);
---
<BaseLayout title="Industrial PTO, Clutch & Pump-Drive Parts">
  <section class="hero hero-home">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="section-label">Independent industrial powertrain sourcing</p>
        <h1>
          Start with the number.
          <span>Finish with a verified fit.</span>
        </h1>
        <p class="hero-lead">
          Search <span translate="no">Twin Disc</span> part numbers and model families, then send the machine identifiers needed to confirm compatibility before ordering.
        </p>

        <form class="hero-search" action="/products" method="get">
          <label for="hero-part-search">Part number, model family or product type</label>
          <div class="search-control search-control--hero">
            <span class="search-glyph" aria-hidden="true">⌕</span>
            <input
              id="hero-part-search"
              name="q"
              type="search"
              placeholder="SP318C003, CX110, clutch…"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="submit">Search catalogue</button>
          </div>
        </form>

        <div class="hero-quick-links">
          <span>Not sure what you have?</span>
          <a href="/rfq">Send a tag, serial or equipment photo <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="id-console" aria-label="Part identification guide">
        <div class="console-head">
          <div>
            <span class="console-kicker">Identification protocol</span>
            <strong>Match the unit before the part.</strong>
          </div>
          <span class="live-indicator"><i aria-hidden="true"></i> RFQ</span>
        </div>

        <div class="disc-visual" aria-hidden="true">
          <div class="disc-ring disc-ring--outer"></div>
          <div class="disc-ring disc-ring--middle"></div>
          <div class="disc-ring disc-ring--inner"></div>
          <span class="disc-axis"></span>
          <span class="disc-caption">MODEL / SERIAL / OEM</span>
        </div>

        <dl class="identity-list">
          <div>
            <dt>01</dt>
            <dd><strong>Unit tag</strong><span>PTO, clutch or transmission model</span></dd>
          </div>
          <div>
            <dt>02</dt>
            <dd><strong>Serial / BOM</strong><span>Assembly-level identification</span></dd>
          </div>
          <div>
            <dt>03</dt>
            <dd><strong>Machine</strong><span>Equipment and engine details</span></dd>
          </div>
        </dl>

        <a class="console-link" href="/rfq">
          Start part identification
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>

    <div class="shell proof-strip" aria-label="Catalogue summary">
      <div><strong>{publicProducts.length}</strong><span>Launch parts</span></div>
      <div><strong>{families.length}</strong><span>Product families</span></div>
      <div><strong>{twinDiscProducts.length}</strong><span>Model guides</span></div>
      <div><strong>RFQ</strong><span>Pricing & fitment</span></div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="section-label">Priority catalogue</p>
        <h2>Known numbers, fast paths.</h2>
      </div>
      <p class="section-copy">
        The launch catalogue is intentionally focused. Search the exact number you have, or open a product record to see what still needs verification.
      </p>
    </div>

    <div class="part-index">
      <div class="part-index__head" aria-hidden="true">
        <span>Part number</span>
        <span>Type</span>
        <span>Model family</span>
        <span>Open</span>
      </div>
      {featured.map((product) => (
        <a class="part-index__row" href={`/products/${product.sku.toLowerCase()}`}>
          <strong translate="no">{product.partNumber}</strong>
          <span class="part-type">{product.family}</span>
          <span>{product.modelFamily}</span>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>

    <div class="section-foot">
      <a class="text-link" href="/products">Browse full catalogue <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="model-showcase">
    <div class="shell">
      <div class="section-heading section-heading--dark">
        <div>
          <p class="section-label section-label--dark">Technical model guides</p>
          <h2>Research the family before the quote.</h2>
        </div>
        <p class="section-copy">
          Model-level reference pages organize specifications, applications, FAQs and the identifiers needed for a reliable RFQ.
        </p>
      </div>

      <div class="model-card-grid">
        {modelGuides.map((product, index) => (
          <a class="model-card" href={`/products/${product.id}/`}>
            <span class="model-card__number">0{index + 1}</span>
            <span class="model-card__category">{categoryLabels[product.category]}</span>
            <strong translate="no">{product.modelName}</strong>
            <p>{product.heroSubtitle}</p>
            <span class="model-card__link">Open technical guide <b aria-hidden="true">→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell verification-section">
    <div class="verification-intro">
      <p class="section-label">Fitment workflow</p>
      <h2>Three steps between a guess and a usable quote.</h2>
      <p>
        The site is designed around evidence, not assumptions. Give us the strongest identifier you have and we work outward from there.
      </p>
    </div>

    <ol class="verification-steps">
      <li>
        <span>01</span>
        <div>
          <strong>Find the reference</strong>
          <p>Search a Twin Disc number, model family or known OEM reference.</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <strong>Verify the unit</strong>
          <p>Use the tag, serial, BOM, machine and engine details to reduce fitment risk.</p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <strong>Request the quote</strong>
          <p>Availability, exact configuration and freight are confirmed before ordering.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="shell final-cta">
    <div>
      <p class="section-label section-label--dark">Have a tag or serial number?</p>
      <h2>That is usually enough to start.</h2>
      <p>Send the identifiers you have. You do not need to know every field before requesting help.</p>
    </div>
    <a class="button button-light button-large" href="/rfq">Start an RFQ <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
