---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicProducts } from "../data/products";

const families = [...new Set(publicProducts.map((product) => product.family))];
const featured = publicProducts.slice(0, 6);
---
<BaseLayout title="Industrial PTO, Clutch & Pump-Drive Parts">
  <section class="showcase-hero">
  <div class="shell showcase-hero__grid">
    <div class="showcase-hero__copy" data-reveal>
      <div class="showcase-eyebrow"><span class="showcase-eyebrow__line"></span> INDUSTRIAL POWERTRAIN / PARTS SOURCING</div>
      <h1>When the machine stops, <em>details matter.</em></h1>
      <p class="showcase-hero__lead">Find Twin Disc PTO, clutch and pump-drive parts by reference number or product family. Confirm the application before you commit to an order.</p>
      <form class="showcase-search" action="/products" method="get">
        <label for="hero-part-search">START WITH A PART NUMBER OR MODEL</label>
        <div class="showcase-search__row">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
          <input id="hero-part-search" name="q" type="search" placeholder="e.g. SP318C003, CX110, clutch..." autocomplete="off" spellcheck="false" />
          <button type="submit">Find parts <span aria-hidden="true">↗</span></button>
        </div>
      </form>
      <div class="showcase-hero__actions"><a href="/products">Explore catalogue <span aria-hidden="true">↗</span></a><a href="/rfq">Need help identifying a part? <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="showcase-hero__visual" aria-label="Technical component identification illustration" data-reveal>
      <div class="showcase-hero__visual-top"><span>FIELD REFERENCE / 001</span><span>POWERTRAIN SYSTEMS</span></div>
      <div class="showcase-engineering">
        <svg viewBox="0 0 600 500" role="img" aria-label="Abstract technical line drawing of a clutch and powertrain assembly">
          <defs>
            <linearGradient id="disc-gradient" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#577b90"/><stop offset="1" stop-color="#162f40"/></linearGradient>
          </defs>
          <g stroke="#57788b" stroke-width="1" opacity=".25"><path d="M0 100H600M0 200H600M0 300H600M0 400H600M100 0V500M200 0V500M300 0V500M400 0V500M500 0V500"/></g>
          <g transform="translate(297 250) rotate(-26)">
            <ellipse rx="188" ry="132" fill="#0e202d" stroke="#5d879f" stroke-width="2"/>
            <ellipse rx="158" ry="109" fill="url(#disc-gradient)" stroke="#8db1c1" stroke-width="3"/>
            <ellipse rx="138" ry="94" fill="#122b39" stroke="#5a8093" stroke-width="2"/>
            <g fill="none" stroke="#a4c9d9" stroke-width="2">
              <ellipse rx="110" ry="77"/><ellipse rx="89" ry="61"/><ellipse rx="63" ry="43"/><ellipse rx="41" ry="27"/>
            </g>
            <g stroke="#87aec2" stroke-width="3">
              <path d="M-164 0h328M0-116v232M-116-84l232 168M-116 84l232-168"/>
            </g>
            <ellipse rx="30" ry="19" fill="#b0c8d0" stroke="#f1f6f6" stroke-width="3"/>
            <ellipse rx="14" ry="9" fill="#0d2230"/>
          </g>
          <g stroke="#b1d9e8" stroke-width="1.3" fill="none"><path d="M382 105L476 52H562"/><circle cx="382" cy="105" r="4"/><path d="M210 370L105 430H35"/><circle cx="210" cy="370" r="4"/></g>
          <g fill="#c2dce6" font-family="monospace" font-size="12"><text x="470" y="40">CLUTCH ASSY.</text><text x="36" y="450">FITMENT CHECK</text></g>
        </svg>
      </div>
      <div class="showcase-hero__visual-bottom"><span>MODEL / SERIAL / BOM</span><strong>IDENTIFY BEFORE ORDERING</strong></div>
    </div>
  </div>
  <div class="shell showcase-stats"><div><strong>{publicProducts.length.toString().padStart(2,"0")}</strong><span>LAUNCH PART REFERENCES</span></div><div><strong>{families.length.toString().padStart(2,"0")}</strong><span>COMPONENT FAMILIES</span></div><div><strong>01</strong><span>VERIFICATION-FIRST PROCESS</span></div><a href="/rfq">START AN RFQ <span aria-hidden="true">↗</span></a></div>
</section>

  <section class="section section-tight shell showcase-catalogue">
    <div class="section-heading" data-reveal>
      <div>
        <p class="kicker">Launch Catalogue</p>
        <h2>Parts worth finding.<br /><em>Applications worth verifying.</em></h2>
      </div>
      <a class="text-link" href="/products">View All {publicProducts.length} Products <span aria-hidden="true">→</span></a>
    </div>

    <div class="featured-list showcase-featured" data-reveal>
      <div class="featured-list__head" aria-hidden="true">
        <span>Part Number</span>
        <span>Family</span>
        <span>Model Family</span>
        <span></span>
      </div>
      {featured.map((product) => (
        <a class="featured-row" href={`/products/${product.sku.toLowerCase()}`}>
          <strong translate="no">{product.partNumber}</strong>
          <span>{product.family}</span>
          <span>{product.modelFamily}</span>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="process">
    <div class="shell process-grid">
      <div class="process-intro" data-reveal>
        <p class="kicker kicker-light">How It Works</p>
        <h2>A more considered way to source components.</h2>
        <p>Part numbers start the search. Equipment evidence finishes it.</p>
      </div>

      <div class="process-steps" data-reveal>
        <article>
          <span class="step-index">01</span>
          <div>
            <h3>Search the Catalogue</h3>
            <p>Use a part number, clutch family, PTO model or known OEM reference.</p>
          </div>
        </article>
        <article>
          <span class="step-index">02</span>
          <div>
            <h3>Confirm the Application</h3>
            <p>Share machine, engine, tag, serial or nameplate information when available.</p>
          </div>
        </article>
        <article>
          <span class="step-index">03</span>
          <div>
            <h3>Receive an RFQ Response</h3>
            <p>Availability, exact fit and freight are checked before an order is placed.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section shell cta-band" data-reveal>
    <div>
      <p class="kicker">Have a Tag, Serial or OEM Number?</p>
      <h2>Tell us what’s on the nameplate.<br /><em>We’ll start there.</em></h2>
    </div>
    <a class="button button-large" href="/rfq">Start Part Identification</a>
  </section>
</BaseLayout>
