---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicProducts } from "../data/products";

const families = [...new Set(publicProducts.map((product) => product.family))];
const featured = publicProducts.slice(0, 6);
---
<BaseLayout title="Industrial PTO, Clutch & Pump-Drive Parts">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="kicker">Industrial powertrain catalogue</p>
        <h1>Part-number first. Fitment verified before order.</h1>
        <p class="hero-lead">
          Search <span translate="no">Twin Disc</span> part numbers and product families, then send the machine identifiers needed to confirm the application before ordering.
        </p>

        <form class="hero-search" action="/products" method="get">
          <label for="hero-part-search">Search part number or model family</label>
          <div class="search-control">
            <input
              id="hero-part-search"
              name="q"
              type="search"
              placeholder="SP318C003, CX110, clutch…"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="submit">Search catalogue</button>
          </div>
          <p class="search-hint">Known item? Start with the full part number for the fastest match.</p>
        </form>

        <div class="hero-meta" aria-label="Catalogue summary">
          <div>
            <strong>{publicProducts.length}</strong>
            <span>Launch products</span>
          </div>
          <div>
            <strong>{families.length}</strong>
            <span>Product families</span>
          </div>
          <div>
            <strong>RFQ</strong>
            <span>Pricing mode</span>
          </div>
        </div>
      </div>

      <aside class="hero-technical" aria-label="Part identification requirements" data-reveal data-reveal-delay="0.08">
        <div class="technical-header">
          <span>IDENTIFICATION CHECK</span>
          <span class="status-dot">EVIDENCE</span>
        </div>
        <div class="technical-body">
          <p class="technical-intro">The best match starts with what is already stamped, tagged or documented on the machine.</p>
          <dl class="identity-list">
            <div>
              <dt>TAG</dt>
              <dd>PTO / clutch tag or serial</dd>
            </div>
            <div>
              <dt>OEM</dt>
              <dd>OEM part number</dd>
            </div>
            <div>
              <dt>EQUIP</dt>
              <dd>Equipment make & model</dd>
            </div>
            <div>
              <dt>ENGINE</dt>
              <dd>Engine make & model</dd>
            </div>
          </dl>
          <a class="text-link text-link-on-dark" href="/rfq">Send equipment details <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-tight shell" data-reveal>
    <div class="section-heading">
      <div>
        <p class="kicker">Launch catalogue</p>
        <h2>Search the identifier you already have.</h2>
      </div>
      <a class="text-link" href="/products">View all {publicProducts.length} products <span aria-hidden="true">↗</span></a>
    </div>

    <div class="featured-list">
      <div class="featured-list__head" aria-hidden="true">
        <span>Part number</span>
        <span>Family</span>
        <span>Model family</span>
        <span></span>
      </div>
      {featured.map((product) => (
        <a class="featured-row" href={"/products/" + product.sku.toLowerCase()}>
          <strong translate="no">{product.partNumber}</strong>
          <span>{product.family}</span>
          <span>{product.modelFamily}</span>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="process">
    <div class="shell process-grid">
      <div class="process-intro" data-reveal>
        <p class="kicker kicker-light">Technical sourcing workflow</p>
        <h2>Three steps, one clean trail of evidence.</h2>
        <p>Search narrows the part. Machine identifiers narrow the fit. The RFQ keeps both together.</p>
      </div>

      <div class="process-steps" data-reveal data-reveal-delay="0.08">
        <article>
          <span class="step-index">SEARCH</span>
          <div>
            <h3>Start with the known identifier</h3>
            <p>Use a part number, clutch family, PTO model or known OEM reference.</p>
          </div>
        </article>
        <article>
          <span class="step-index">VERIFY</span>
          <div>
            <h3>Add machine evidence</h3>
            <p>Share tag, serial, equipment and engine information when the application is uncertain.</p>
          </div>
        </article>
        <article>
          <span class="step-index">RFQ</span>
          <div>
            <h3>Carry the match into the quote request</h3>
            <p>Availability, exact fit and freight can be checked before an order is placed.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section shell cta-band" data-reveal>
    <div>
      <p class="kicker">No exact catalogue match?</p>
      <h2>Send the tag, serial or OEM number instead.</h2>
    </div>
    <a class="button button-large" href="/rfq">Start part identification</a>
  </section>
</BaseLayout>
