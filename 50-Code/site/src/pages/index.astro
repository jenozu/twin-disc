---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceHero from "../components/ExperienceHero.astro";
import FamilyExplorer from "../components/FamilyExplorer.astro";
import IdentificationStory from "../components/IdentificationStory.astro";
import SearchBand from "../components/SearchBand.astro";
import CataloguePreview from "../components/CataloguePreview.astro";
---
<BaseLayout robots="noindex, follow" title="Industrial Powertrain Parts | Precision Sourcing" description="Find Twin Disc PTO, clutch and pump-drive components. Explore part numbers and industrial model references, then prepare a part-identification request.">
  <ExperienceHero />
  <div class="xp-home"><SearchBand /><FamilyExplorer /><IdentificationStory /><CataloguePreview /></div>
  <section class="xp-final" aria-labelledby="xp-final-title">
    <div class="xp-final__halo" aria-hidden="true"></div>
    <div class="shell xp-final__inner" data-reveal>
      <p class="xp-eyebrow">04 / WHAT'S NEXT</p><h2 id="xp-final-title">Every machine has<br/><em>a next move.</em></h2>
      <p>Tell us what you're working with. We'll start with the evidence and work toward the right component.</p>
      <a href="/rfq/" class="xp-button xp-button--cream">Start a request <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>