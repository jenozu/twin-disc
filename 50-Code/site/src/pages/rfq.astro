---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Request a Quote | Powertrain Parts">
  <section class="rfq-hero">
    <div class="shell rfq-hero__grid" data-reveal>
      <div>
        <p class="registry-code registry-code--dark">INTAKE / 02</p>
        <h1>RFQ</h1>
      </div>
      <div class="rfq-hero__copy">
        <strong>Identify first. Quote second.</strong>
        <p>A tag, serial or OEM number is usually more useful than a long description. Complete only the fields you know.</p>
      </div>
    </div>
  </section>

  <section class="rfq-stage shell">
    <aside class="rfq-guide" data-reveal>
      <p class="kicker">Evidence priority</p>
      <ol>
        <li><span>01</span><div><strong>Tag / serial</strong><p>PTO, clutch or transmission identifiers.</p></div></li>
        <li><span>02</span><div><strong>OEM number</strong><p>Useful for cross-reference work.</p></div></li>
        <li><span>03</span><div><strong>Machine context</strong><p>Equipment and engine make/model.</p></div></li>
      </ol>
      <p class="rfq-guide__note">You do not need every field. Send the strongest identifiers you have.</p>
    </aside>

    <div class="rfq-sheet" data-reveal data-reveal-delay="0.08">
      <div class="rfq-sheet__header">
        <span>TECHNICAL INTAKE</span>
        <span>* REQUIRED</span>
      </div>

      <form id="rfq-form" novalidate>
        <fieldset>
          <legend><span>01</span> Part record</legend>
          <div class="form-grid">
            <label>
              Part Number
              <input id="part" name="part" placeholder="SP318C003…" autocomplete="off" spellcheck="false" />
            </label>
            <label>
              OEM Part Number
              <input name="oem" placeholder="If available…" autocomplete="off" spellcheck="false" />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend><span>02</span> Machine context</legend>
          <div class="form-grid">
            <label>
              Equipment Make & Model
              <input name="equipment" placeholder="Bandit Beast 3680…" autocomplete="off" />
            </label>
            <label>
              Engine Make & Model
              <input name="engine" placeholder="If known…" autocomplete="off" />
            </label>
          </div>

          <label>
            PTO / Clutch / Transmission Model or Serial
            <input name="drive" placeholder="Tag, serial number or model…" autocomplete="off" spellcheck="false" />
          </label>
        </fieldset>

        <fieldset>
          <legend><span>03</span> Request</legend>
          <label>
            What Do You Need?
            <textarea name="message" placeholder="Part needed, quantity, failure symptoms or application details…"></textarea>
          </label>

          <label>
            Photos (Optional)
            <input
              id="photos"
              type="file"
              name="photos"
              accept="image/*,.heic,.heif"
              multiple
              aria-describedby="photos-help"
            />
            <span id="photos-help" class="field-help">Add up to 5 nameplate, serial-tag, equipment or damage photos.</span>
          </label>

          <label>
            Email Address *
            <input
              type="email"
              name="email"
              required
              placeholder="you@company.com…"
              autocomplete="email"
              spellcheck="false"
            />
          </label>
        </fieldset>

        <div class="form-submit">
          <button class="button button-large" type="submit">Prepare RFQ <span aria-hidden="true">↗</span></button>
          <p>Prototype mode: email delivery will be connected before public launch.</p>
        </div>
      </form>

      <div id="rfq-result" class="result-panel" role="status" aria-live="polite" hidden>
        <strong>RFQ captured for testing</strong>
        <p id="rfq-summary"></p>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(location.search);
    const part = document.querySelector<HTMLInputElement>("#part");
    if (part && params.get("part")) part.value = params.get("part") ?? "";

    const form = document.querySelector<HTMLFormElement>("#rfq-form");
    const photos = document.querySelector<HTMLInputElement>("#photos");
    const result = document.querySelector<HTMLElement>("#rfq-result");
    const summary = document.querySelector<HTMLElement>("#rfq-summary");

    photos?.addEventListener("change", () => {
      const count = photos.files?.length ?? 0;
      photos.setCustomValidity(count > 5 ? "Please select no more than 5 images." : "");
      photos.setAttribute("aria-invalid", count > 5 ? "true" : "false");
    });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const email = form.elements.namedItem("email") as HTMLInputElement | null;
      if (email && !email.validity.valid) {
        email.setAttribute("aria-invalid", "true");
        email.focus();
        return;
      }
      email?.removeAttribute("aria-invalid");

      if (photos && !photos.validity.valid) {
        photos.reportValidity();
        photos.focus();
        return;
      }

      const data = new FormData(form);
      const details = [...data.entries()]
        .filter(([, value]) => {
          if (value instanceof File) return value.size > 0;
          return String(value).trim();
        })
        .map(([key, value]) =>
          value instanceof File ? key + ": " + value.name : key + ": " + value
        )
        .join(" | ");

      if (summary) summary.textContent = details;
      if (result) result.hidden = false;
      result?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  </script>
</BaseLayout>
