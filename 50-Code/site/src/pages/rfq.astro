---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Request a Quote | Powertrain Parts">
  <section class="page-masthead">
    <div class="shell masthead-grid">
      <div>
        <p class="kicker">01 / REQUEST A QUOTE</p>
        <h1>Let’s find the<br/>right part.</h1>
      </div>
      <p class="masthead-copy">
        Start with a part number, serial tag, OEM reference or a photo. Use this guided intake to prepare the details for technical verification. Only fill in what you know.
      </p>
    </div>
  </section>

  <section class="section shell rfq-layout">
    <aside class="rfq-guide">
      <div class="guide-block">
        <span class="guide-label">BEST IDENTIFIER</span>
        <strong>PTO / clutch tag or serial</strong>
        <p>A clear model or serial number usually provides the fastest path to verification.</p>
      </div>
      <div class="guide-block">
        <span class="guide-label">ALSO USEFUL</span>
        <strong>Machine & engine details</strong>
        <p>Equipment make/model and engine make/model help narrow the application.</p>
      </div>
      <div class="guide-block">
        <span class="guide-label">IF AVAILABLE</span>
        <strong>OEM part number</strong>
        <p>Cross-reference numbers can help identify a service or replacement path.</p>
      </div>
    </aside>

    <div class="rfq-panel">
      <div class="rfq-panel__header">
        <span>PART IDENTIFICATION / RFQ PREPARATION</span>
        <span>Fields marked * are required</span>
      </div>

      <form id="rfq-form" novalidate>
        <fieldset>
          <legend>Part Information</legend>
          <div class="form-grid">
            <label>
              Part Number
              <input id="part" name="part" placeholder="SP318C003…" autocomplete="off" spellcheck="false" />
            </label>
            <label>
              OEM Part Number
              <input name="oem" placeholder="If available…" autocomplete="off" spellcheck="false" />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Equipment Information</legend>
          <div class="form-grid">
            <label>
              Equipment Make & Model
              <input name="equipment" placeholder="Bandit Beast 3680…" autocomplete="off" />
            </label>
            <label>
              Engine Make & Model
              <input name="engine" placeholder="If known…" autocomplete="off" />
            </label>
          </div>

          <label>
            PTO / Clutch / Transmission Model or Serial
            <input name="drive" placeholder="Tag, serial number or model…" autocomplete="off" spellcheck="false" />
          </label>
        </fieldset>

        <fieldset>
          <legend>Request Details</legend>
          <label>
            What Do You Need?
            <textarea name="message" placeholder="Part needed, quantity, failure symptoms or application details…"></textarea>
          </label>

          <label>
            Photos (Optional)
            <input
              id="photos"
              type="file"
              name="photos"
              accept="image/*,.heic,.heif"
              multiple
            />
            <span class="field-help">Add up to 5 nameplate, serial-tag, equipment or damage photos.</span>
          </label>

          <label>
            Email Address *
            <input
              type="email"
              name="email"
              required
              placeholder="you@company.com…"
              autocomplete="email"
              spellcheck="false"
            />
          </label>
        </fieldset>

        <div class="form-submit">
          <button class="button button-large" type="submit">Review Your Request <span aria-hidden="true">↗</span></button>
          <p>This preview prepares a request locally; it does not send email or store submissions. You can copy or save your summary below.</p>
        </div>
      </form>

      <div id="rfq-result" class="result-panel" role="status" aria-live="polite" hidden>
        <strong>Request summary prepared — not submitted</strong>
        <p>Your details are ready for review. No inquiry has been delivered, saved on a server or sent to a supplier.</p>
        <p id="rfq-summary" style="white-space:pre-wrap;overflow-wrap:anywhere"></p>
        <div class="ed-rfq-actions"><button type="button" id="copy-rfq">Copy request details</button><button type="button" id="save-rfq">Save text file</button></div>
        <p id="rfq-feedback" aria-live="polite"></p>
        <small>Attached photo names appear in the summary, but the files themselves are not included in copied text. You must attach the photos when sending your inquiry through an approved channel.</small>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(location.search);
    const part = document.querySelector<HTMLInputElement>("#part");
    if (part && params.get("part")) part.value = params.get("part") ?? "";
    const form = document.querySelector<HTMLFormElement>("#rfq-form");
    const photos = document.querySelector<HTMLInputElement>("#photos");
    const result = document.querySelector<HTMLElement>("#rfq-result");
    const summary = document.querySelector<HTMLElement>("#rfq-summary");
    const feedback = document.querySelector<HTMLElement>("#rfq-feedback");
    let prepared = "";
    photos?.addEventListener("change", () => {
      const count = photos.files?.length ?? 0;
      photos.setCustomValidity(count > 5 ? "Please select no more than 5 images." : "");
      photos.setAttribute("aria-invalid", String(count > 5));
      if (count > 5) photos.reportValidity();
    });
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const email = form.elements.namedItem("email") as HTMLInputElement | null;
      if (email && !email.validity.valid) {
        email.setAttribute("aria-invalid", "true");
        email.reportValidity();
        email.focus();
        if (result) result.hidden = true;
        return;
      }
      email?.removeAttribute("aria-invalid");
      if (photos && !photos.validity.valid) {
        photos.reportValidity();
        photos.focus();
        if (result) result.hidden = true;
        return;
      }
      const data = new FormData(form);
      const fields = [
        ["Part number", data.get("part")],
        ["OEM part number", data.get("oem")],
        ["Equipment", data.get("equipment")],
        ["Engine", data.get("engine")],
        ["PTO / clutch / transmission model", data.get("drive")],
        ["Request details", data.get("message")],
        ["Reply email", data.get("email")],
      ].filter(([, value]) => String(value ?? "").trim())
        .map(([key, value]) => String(key) + ": " + String(value));
      const files = Array.from(photos?.files ?? []).filter((file) => file.size > 0);
      if (files.length) fields.push("Photos to attach separately: " + files.map((file) => file.name).join(", "));
      prepared = "POWERTRAIN PARTS — RFQ PREPARATION\n"
        + "This is an unsubmitted draft. Confirm the recipient and attach photos before sending.\n\n"
        + fields.join("\n");
      if (summary) summary.textContent = prepared;
      if (feedback) feedback.textContent = "";
      if (result) result.hidden = false;
      result?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
    });
    document.getElementById("copy-rfq")?.addEventListener("click", async () => {
      if (!prepared) return;
      try {
        await navigator.clipboard.writeText(prepared);
        if (feedback) feedback.textContent = "Draft copied. It has not been submitted.";
      } catch {
        if (feedback) feedback.textContent = "Automatic copying is unavailable. Select and copy the summary above.";
      }
    });
    document.getElementById("save-rfq")?.addEventListener("click", () => {
      if (!prepared) return;
      const blob = new Blob([prepared], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url; link.download = "powertrain-parts-rfq-draft.txt";
      document.body.appendChild(link); link.click(); link.remove();
      URL.revokeObjectURL(url);
      if (feedback) feedback.textContent = "Draft saved locally. It has not been submitted.";
    });
  </script>
</BaseLayout>
