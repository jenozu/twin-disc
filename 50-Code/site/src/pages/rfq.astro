---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/rfq-04.css";
---
<BaseLayout
  title="Twin Disc Parts Identification & Replacement Quote | Ontario"
  description="Request help identifying Twin Disc PTO, clutch or marine parts in Ontario. Model, serial and BOM numbers are optional. All fitment requires review."
  robots="noindex, follow"
>
  <section class="page-masthead">
    <div class="shell masthead-grid">
      <div>
        <p class="kicker">PART IDENTIFICATION / QUOTE REQUEST</p>
        <h1>Tell us what you know.</h1>
      </div>
      <p class="masthead-copy">You can request a replacement without knowing your Twin Disc model, serial number or BOM. Every compatibility recommendation requires review.</p>
    </div>
  </section>
  <div class="shell rfq04-wrap">
    <aside class="rfq04-aside">
      <p class="kicker">HOW THIS WORKS</p>
      <h2>Start with the problem. We'll review the details.</h2>
      <p>Describe what needs replacing, provide any available machine information, and choose how to be contacted. You do not need an account.</p>
      <ol>
        <li>Your inquiry is stored securely and assigned a reference.</li>
        <li>Identification and compatibility are reviewed before a quote.</li>
        <li>Someone will follow up using your preferred contact method when the team is configured and available.</li>
      </ol>
      <div class="rfq04-notice">
        <strong>Photos are optional.</strong>
        <p>Only photograph equipment and identification plates when safely accessible. Never remove guards, dismantle or operate equipment for a photograph.</p>
      </div>
      <p class="rfq04-small">This is an independent parts inquiry service, not a manufacturer fitment guarantee or confirmed stock offer.</p>
    </aside>
    <section class="rfq04-panel" aria-labelledby="rfq04-title">
      <div class="rfq04-panelhead">
        <div><span>REPLACEMENT INQUIRY</span><h2 id="rfq04-title">Request identification or a quote</h2></div>
        <span id="rfq-progress-caption" aria-live="polite">Step 1 of 3</span>
      </div>
      <ol class="rfq04-progress" aria-label="Form progress">
        <li class="is-current" data-progress="1">1. Requirement</li>
        <li data-progress="2">2. Identification</li>
        <li data-progress="3">3. Contact</li>
      </ol>
      <form id="rfq04-form" novalidate>
        <fieldset data-step="1">
          <legend>01 / What do you need?</legend>
          <div class="rfq04-fields">
            <label>Replacement type <span aria-hidden="true">*</span>
              <select required name="category">
                <option value="">Choose one</option><option value="pto">Complete PTO assembly</option>
                <option value="clutch">Clutch assembly</option><option value="component">Individual replacement component</option>
                <option value="marine">Marine transmission or component</option><option value="unsure">Not sure</option>
              </select>
            </label>
            <label>Reason for replacing <span aria-hidden="true">*</span>
              <select required name="reason"><option value="">Choose one</option>
                <option value="failed">Damaged or failed</option><option value="worn">Worn component</option>
                <option value="maintenance">Planned maintenance</option><option value="upgrade">Equipment upgrade</option>
                <option value="unknown">Unknown</option></select>
            </label>
            <label>Equipment condition <span aria-hidden="true">*</span>
              <select required name="condition"><option value="">Choose one</option>
                <option value="out_of_service">Out of service</option><option value="operational">Still operational</option>
                <option value="planned">Planned maintenance</option></select>
            </label>
            <label>When do you need it? <span aria-hidden="true">*</span>
              <select required name="urgency"><option value="">Choose one</option>
                <option value="asap">As soon as possible</option><option value="one_week">Within one week</option>
                <option value="one_month">Within one month</option><option value="planning">Planning ahead</option></select>
            </label>
          </div>
          <label>Describe the problem (optional)
            <textarea name="description" maxlength="2000" rows="4" placeholder="Symptoms, damaged part, quantity or work planned..."></textarea>
          </label>
        </fieldset>
        <fieldset data-step="2" hidden>
          <legend>02 / Equipment identification</legend>
          <p>All fields on this step are optional. Missing numbers do not prevent submission.</p>
          <label class="rfq04-check"><input id="rfq-unknown-ids" type="checkbox" /> I don't know my model, serial or BOM numbers</label>
          <p id="rfq-unknown-help" class="rfq04-help" hidden>That's fine. A machine manufacturer/model or safe photos may help begin identification.</p>
          <div class="rfq04-fields">
            <label>Twin Disc model number<input name="model_number" data-identifier maxlength="160" placeholder="If known" /></label>
            <label>Serial number<input name="serial_number" data-identifier maxlength="160" /></label>
            <label>BOM number<input name="bom_number" data-identifier maxlength="160" /></label>
            <label>Original part number<input id="rfq-part-number" name="part_number" data-identifier maxlength="160" /></label>
            <label>OEM part number<input name="oem_part_number" maxlength="160" /></label>
            <label>Equipment manufacturer<input name="equipment_manufacturer" maxlength="160" /></label>
            <label>Equipment model<input name="equipment_model" maxlength="160" /></label>
            <label>Equipment type/application<input name="equipment_type" maxlength="160" /></label>
            <label>Engine make and model<input name="engine" maxlength="160" /></label>
            <label>Engine horsepower<input name="horsepower" inputmode="decimal" maxlength="160" /></label>
            <label>Rated RPM<input name="rpm" inputmode="numeric" maxlength="160" /></label>
            <label>Drive arrangement<input name="drive_arrangement" maxlength="160" /></label>
          </div>
          <label>Technical notes<textarea name="technical_notes" maxlength="2000" rows="3"></textarea></label>
          <label>Safe photographs or a PDF (optional)
            <input type="file" id="rfq-attachments" name="attachments" accept="image/jpeg,image/png,application/pdf,.jpg,.jpeg,.png,.pdf" multiple />
            <span class="rfq04-help">Up to 3 files, maximum 1 MB each. JPEG, PNG, and PDF only. Files are private and require authorized review.</span>
          </label>
          <p id="rfq-file-message" class="rfq04-help" role="status" aria-live="polite"></p>
        </fieldset>
        <fieldset data-step="3" hidden>
          <legend>03 / How may we contact you?</legend>
          <div class="rfq04-fields">
            <label>Contact name *<input name="name" required autocomplete="name" maxlength="100" /></label>
            <label>Company (optional)<input name="company" autocomplete="organization" maxlength="160" /></label>
            <label>Email (email or phone required)<input type="email" name="email" autocomplete="email" maxlength="160" /></label>
            <label>Telephone (email or phone required)<input type="tel" name="phone" autocomplete="tel" maxlength="160" /></label>
            <label>City or town *<input name="city" required autocomplete="address-level2" maxlength="100" /></label>
            <label>Province *<input name="province" value="Ontario" required autocomplete="address-level1" maxlength="100" /></label>
            <label>Postal code (optional)<input name="postal_code" autocomplete="postal-code" maxlength="160" /></label>
            <label>Preferred contact method *
              <select name="preferred_contact" required><option value="either">Either</option>
                <option value="email">Email</option><option value="phone">Phone</option></select>
            </label>
          </div>
          <label>Additional comments<textarea name="comments" rows="3" maxlength="2000"></textarea></label>
          <div class="rfq04-consent">
            <label class="rfq04-check"><input type="checkbox" name="privacy_acknowledged" required /> I understand the information supplied will be used to review and respond to my parts inquiry. *</label>
            <p class="rfq04-help">Photos and contact details are retained for inquiry follow-up and reviewed only by authorized personnel. Contact the business for access, corrections or deletion requests. A formal privacy notice and retention policy require owner approval before launch.</p>
            <label class="rfq04-check"><input type="checkbox" name="marketing_consent" /> Separately, I would like optional product updates and marketing communications.</label>
          </div>
          <label class="rfq04-honeypot" aria-hidden="true">Website<input type="text" name="honeypot" tabindex="-1" autocomplete="off" /></label>
        </fieldset>
        <div id="rfq04-error" role="alert" aria-live="assertive" hidden></div>
        <div class="rfq04-actions">
          <button class="button" id="rfq04-prev" type="button" hidden>Previous</button>
          <button class="button" id="rfq04-next" type="button">Next step</button>
          <button class="button" id="rfq04-submit" type="submit" hidden>Submit secure inquiry</button>
          <span id="rfq04-state" role="status" aria-live="polite"></span>
        </div>
      </form>
      <div id="rfq04-success" role="status" aria-live="polite" hidden tabindex="-1">
        <h3>Inquiry received</h3>
        <p>Your inquiry reference: <strong id="rfq04-reference"></strong></p>
        <p id="rfq04-success-message">Your details have been stored for review. An exact replacement or availability has not yet been confirmed.</p>
        <a href="/products">Browse parts catalogue</a>
      </div>
    </section>
  </div>
  <script>import "../scripts/rfq-wizard";</script>
</BaseLayout>
