---
import "lenis/dist/lenis.css";
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = "Powertrain Parts",
  description = "Independent sourcing and RFQ support for Twin Disc PTO, clutch, friction and pump-drive parts.",
  canonicalUrl,
  structuredData = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const catalogueActive = pathname.startsWith("/products");
const rfqActive = pathname.startsWith("/rfq");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f12" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <title>{title}</title>
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="utility-bar">
      <div class="shell utility-bar__inner">
        <span>Independent industrial parts sourcing</span>
        <span>Part-number search · Fitment verification · RFQ</span>
      </div>
    </div>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Powertrain Parts home">
          <span class="brand-mark" aria-hidden="true"><span>PT</span></span>
          <span class="brand-copy">
            <strong>POWERTRAIN</strong>
            <span>PARTS / TECHNICAL SOURCING</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a href="/products" aria-current={catalogueActive ? "page" : undefined}>Catalogue</a>
          <a href="/rfq" aria-current={rfqActive ? "page" : undefined}>Part Identification</a>
          <a class="button button-compact" href="/rfq">Request Quote</a>
        </nav>

        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav class="mobile-nav__panel" aria-label="Mobile navigation">
            <a href="/products" aria-current={catalogueActive ? "page" : undefined}>Catalogue</a>
            <a href="/rfq" aria-current={rfqActive ? "page" : undefined}>Part Identification</a>
            <a class="button button-block" href="/rfq">Request Quote</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand brand-footer" href="/" aria-label="Powertrain Parts home">
            <span class="brand-mark" aria-hidden="true"><span>PT</span></span>
            <span class="brand-copy">
              <strong>POWERTRAIN</strong>
              <span>PARTS / TECHNICAL SOURCING</span>
            </span>
          </a>
          <p class="footer-copy">
            Independent sourcing for industrial PTO, clutch, friction and pump-drive components.
          </p>
        </div>

        <div class="footer-meta">
          <span class="footer-label">BUYING WORKFLOW</span>
          <strong>Identify → verify → quote</strong>
          <p>Known part data is carried into the RFQ so you do not have to start over.</p>
        </div>

        <div class="footer-meta">
          <span class="footer-label">REFERENCE STANDARD</span>
          <strong>Evidence before fitment claims</strong>
          <p>Model, serial, BOM and equipment details are used to reduce ordering risk.</p>
        </div>
      </div>

      <div class="shell footer-bottom">
        <span>Independent supplier · Not an official <span translate="no">Twin Disc</span> website</span>
        <div class="footer-links">
          <a href="/products">Catalogue</a>
          <a href="/rfq">Request Quote</a>
        </div>
      </div>
    </footer>

    <script>
      import { bootMotion, teardownMotion } from "../scripts/motion";

      const startMotion = () => bootMotion();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startMotion, { once: true });
      } else {
        startMotion();
      }

      window.addEventListener("pagehide", teardownMotion, { once: true });
    </script>
  </body>
</html>
