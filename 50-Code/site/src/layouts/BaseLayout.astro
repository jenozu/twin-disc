---
import "lenis/dist/lenis.css";
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = "Powertrain Parts",
  description = "Independent sourcing and RFQ support for Twin Disc PTO, clutch, friction and pump-drive parts.",
  canonicalUrl,
  structuredData = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const catalogueActive = pathname.startsWith("/products");
const rfqActive = pathname.startsWith("/rfq");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d0f" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <title>{title}</title>
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Powertrain Parts home">
          <span class="brand-code" aria-hidden="true">PT/01</span>
          <span class="brand-copy">
            <strong>POWERTRAIN PARTS</strong>
            <span>INDEPENDENT SOURCING DESK</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a href="/products" aria-current={catalogueActive ? "page" : undefined}>
            <span>01</span> Catalogue
          </a>
          <a href="/rfq" aria-current={rfqActive ? "page" : undefined}>
            <span>02</span> Identify
          </a>
          <a class="header-rfq" href="/rfq">Start RFQ <b aria-hidden="true">↗</b></a>
        </nav>

        <details class="mobile-nav">
          <summary aria-label="Open navigation">Menu</summary>
          <nav class="mobile-nav__panel" aria-label="Mobile navigation">
            <a href="/products" aria-current={catalogueActive ? "page" : undefined}>01 / Catalogue</a>
            <a href="/rfq" aria-current={rfqActive ? "page" : undefined}>02 / Part identification</a>
            <a class="button button-block" href="/rfq">Start RFQ</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-action">
        <div>
          <p class="kicker kicker-on-dark">Procurement desk</p>
          <h2>Have a tag, serial or part number?</h2>
        </div>
        <a class="footer-action__link" href="/rfq">
          Start an RFQ
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand brand-footer" href="/" aria-label="Powertrain Parts home">
            <span class="brand-code" aria-hidden="true">PT/01</span>
            <span class="brand-copy">
              <strong>POWERTRAIN PARTS</strong>
              <span>INDEPENDENT SOURCING DESK</span>
            </span>
          </a>
          <p>
            Independent sourcing for industrial PTO, clutch, friction and pump-drive components.
          </p>
        </div>

        <div class="footer-column">
          <span>WORKFLOW</span>
          <a href="/products">Search catalogue</a>
          <a href="/rfq">Identify a part</a>
        </div>

        <div class="footer-column">
          <span>ORDERING STANDARD</span>
          <p>Part number + machine evidence before fitment is treated as confirmed.</p>
        </div>
      </div>

      <div class="shell footer-bottom">
        <span>Independent supplier · Not an official <span translate="no">Twin Disc</span> website</span>
        <span>Catalogue / RFQ / Verification</span>
      </div>
    </footer>

    <script>
      import { bootMotion, teardownMotion } from "../scripts/motion";

      const startMotion = () => bootMotion();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startMotion, { once: true });
      } else {
        startMotion();
      }

      window.addEventListener("pagehide", teardownMotion, { once: true });
    </script>
  </body>
</html>
