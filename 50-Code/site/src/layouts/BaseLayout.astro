---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = "Powertrain Parts",
  description = "Independent sourcing and RFQ support for Twin Disc PTO, clutch, friction and pump-drive parts.",
  canonicalUrl,
  structuredData = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const catalogueActive = pathname.startsWith("/products");
const rfqActive = pathname.startsWith("/rfq");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1720" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <title>{title}</title>
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="utility-bar">
      <div class="shell utility-bar__inner">
        <span>Independent technical parts sourcing</span>
        <span class="utility-bar__secondary">RFQ-based · Fitment verified before order</span>
      </div>
    </div>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Powertrain Parts home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-copy">
            <strong>POWERTRAIN</strong>
            <span>PARTS</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a class:list={["nav-link", { "is-active": catalogueActive }]} href="/products" aria-current={catalogueActive ? "page" : undefined}>
            Catalogue
          </a>
          <a class:list={["nav-link", "nav-link--secondary", { "is-active": rfqActive }]} href="/rfq" aria-current={rfqActive ? "page" : undefined}>
            Part identification
          </a>
          <a class="button button-compact" href="/rfq">Request quote</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand brand-footer" href="/" aria-label="Powertrain Parts home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-copy">
              <strong>POWERTRAIN</strong>
              <span>PARTS</span>
            </span>
          </a>
          <p class="footer-copy">
            Independent sourcing for industrial PTO, clutch, friction and pump-drive components.
          </p>
        </div>

        <div class="footer-meta">
          <span class="footer-label">Ordering standard</span>
          <strong>Verify before order</strong>
          <p>Compatibility and availability are confirmed before a quote becomes an order.</p>
        </div>

        <div class="footer-meta">
          <span class="footer-label">Support model</span>
          <strong>Email-first technical support</strong>
          <p>Use the RFQ form to send part numbers, equipment details and identification photos.</p>
        </div>
      </div>

      <div class="shell footer-bottom">
        <span>Independent supplier · Not an official <span translate="no">Twin Disc</span> website</span>
        <div class="footer-links">
          <a href="/products">Catalogue</a>
          <a href="/rfq">Request quote</a>
        </div>
      </div>
    </footer>
  </body>
</html>
