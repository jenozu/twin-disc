---
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = "Powertrain Parts",
  description = "Independent sourcing and RFQ support for Twin Disc PTO, clutch, friction and pump-drive parts.",
  canonicalUrl,
  structuredData = [],
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f171d" />
    <meta name="color-scheme" content="light" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <title>{title}</title>
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to Content</a>

    <div class="utility-bar" aria-hidden="true">
      <div class="shell utility-bar__inner">
        <span>Independent Industrial Parts Sourcing</span>
        <span>RFQ-Based · Compatibility Verified Before Order</span>
      </div>
    </div>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Powertrain Parts home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-copy">
            <strong>POWERTRAIN</strong>
            <span>PARTS</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a href="/products">Catalogue</a>
          <a href="/rfq">Part Identification</a>
          <a class="button button-compact" href="/rfq">Request Quote</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand brand-footer" href="/">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-copy">
              <strong>POWERTRAIN</strong>
              <span>PARTS</span>
            </span>
          </a>
          <p class="footer-copy">Independent sourcing for industrial PTO, clutch, friction and pump-drive components.</p>
        </div>

        <div class="footer-meta">
          <strong>Ordering Standard</strong>
          <p>Compatibility and availability are verified before a quote becomes an order.</p>
        </div>

        <div class="footer-meta">
          <strong>Manufacturer Reference</strong>
          <p><span translate="no">Twin Disc</span> names and part numbers are used for product identification.</p>
        </div>
      </div>

      <div class="shell footer-bottom">
        <span>Independent supplier · Not an official <span translate="no">Twin Disc</span> website</span>
        <a href="/rfq">Request Quote</a>
      </div>
    </footer>

    <script>
      import { bootMotion, teardownMotion } from "../scripts/motion";

      const startMotion = () => bootMotion();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startMotion, { once: true });
      } else {
        startMotion();
      }

      window.addEventListener("pagehide", teardownMotion, { once: true });
    </script>
  </body>
</html>
