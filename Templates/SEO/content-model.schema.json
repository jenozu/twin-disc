{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO-02 page record — design only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "canonicalPath",
    "intent",
    "title",
    "h1",
    "metaDescription",
    "status",
    "sourceIds",
    "claims",
    "review",
    "sections",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "type": {
      "enum": [
        "category",
        "model-hub",
        "sku",
        "identification",
        "comparison",
        "troubleshooting",
        "maintenance",
        "repair-vs-replace",
        "application",
        "location",
        "rfq-solution"
      ]
    },
    "canonicalPath": {
      "type": "string",
      "pattern": "^/[a-z0-9/-]*/$"
    },
    "intent": {
      "type": "string",
      "minLength": 8
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "h1": {
      "type": "string",
      "minLength": 8
    },
    "metaDescription": {
      "type": "string",
      "minLength": 30,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "Research",
        "StructuredEvidence",
        "AIDraft",
        "AutomatedValidation",
        "TechnicalReview",
        "CommercialLegalReview",
        "Approved",
        "Published",
        "NeedsRevalidation",
        "Hold",
        "Retired"
      ]
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "sku": {
      "type": [
        "string",
        "null"
      ]
    },
    "partNumber": {
      "type": [
        "string",
        "null"
      ]
    },
    "familyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "regionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "documentRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "missingEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contentHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "extra": {
      "type": "object",
      "description": "Template-specific fields, not authorisation of technical claims"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "sourceSku",
        "relationshipType",
        "targetType",
        "target",
        "scope",
        "evidenceLevel",
        "publishRule",
        "sourceUrl",
        "sourceId",
        "technicalReviewStatus",
        "approvedForPublication"
      ],
      "properties": {
        "claimId": {
          "type": "string"
        },
        "sourceSku": {
          "type": "string"
        },
        "relationshipType": {
          "enum": [
            "MEMBER_OF",
            "PART_DEFINITION",
            "COMPONENT_OF",
            "CONFIGURATION",
            "OEM_CROSS_REFERENCE",
            "AFTERMARKET_CROSS_REFERENCE",
            "USED_IN_EQUIPMENT",
            "APPLICATION_CLUSTER",
            "SERVICE_REPLACED_BY",
            "SUPERSEDED_BY",
            "POSSIBLE_COMPATIBILITY"
          ]
        },
        "targetType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "evidenceLevel": {
          "type": "string"
        },
        "publishRule": {
          "enum": [
            "Yes",
            "Family-only",
            "Review",
            "Hold",
            "No"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceId": {
          "type": "string"
        },
        "documentRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicableSerialOrBom": {
          "type": [
            "string",
            "null"
          ]
        },
        "technicalReviewStatus": {
          "enum": [
            "Pending",
            "Approved",
            "Rejected",
            "NeedsRevalidation"
          ]
        },
        "approvedForPublication": {
          "type": "boolean"
        },
        "technicalReviewerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "nextReviewAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technicalApproved",
        "commercialApproved",
        "assetsApproved",
        "identityApproved",
        "privacyApproved",
        "nextReviewAt"
      ],
      "properties": {
        "technicalApproved": {
          "type": "boolean"
        },
        "commercialApproved": {
          "type": "boolean"
        },
        "assetsApproved": {
          "type": "boolean"
        },
        "identityApproved": {
          "type": "boolean"
        },
        "privacyApproved": {
          "type": "boolean"
        },
        "technicalReviewerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "commercialReviewerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextReviewAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "technicalReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "commercialReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "href",
        "anchor",
        "relation",
        "evidenceClaimIds"
      ],
      "properties": {
        "href": {
          "type": "string",
          "pattern": "^/"
        },
        "anchor": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "evidenceClaimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "sku"
          }
        }
      },
      "then": {
        "required": [
          "sku",
          "partNumber"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model-hub"
          }
        }
      },
      "then": {
        "required": [
          "familyId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "location"
          }
        }
      },
      "then": {
        "required": [
          "regionId"
        ]
      }
    }
  ],
  "description": "Syntactic schema only. Semantic evidence validation and real human approvals still mandatory."
}
